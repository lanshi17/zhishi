# ─── Core ───
ADMIN_USER_ID=wxid_your_admin_id
WORKSPACE_ROOT=/workspace

# ─── LLM (OpenAI-compatible) ───
LLM_BASE_URL=http://localhost:11434/v1
LLM_MODEL=qwen2.5-coder
LLM_API_KEY=
LLM_SUPPORTS_IMAGE_INPUT=false

# ─── PostgreSQL ───
DATABASE_URL=postgres://postgres:postgres@localhost:5432/wechat_claw
PG_POOL_MAX=10
PG_POOL_IDLE_TIMEOUT_MS=30000

# ─── LightRAG Knowledge Base ───
LIGHTRAG_ENABLED=true
LIGHTRAG_API_URL=http://localhost:9621
LIGHTRAG_API_KEY=
LIGHTRAG_TIMEOUT_MS=5000

# ─── Health Tracking Defaults ───
HEALTH_DEFAULT_CALORIE_GOAL=2000
HEALTH_DEFAULT_BURN_GOAL=500
# Conversation-history token budget (conservatively estimated); defaults to 256000
LLM_CONTEXT_WINDOW=256000

# ─── iLink WeChat Bot ───
ILINK_BOT_TOKEN=
